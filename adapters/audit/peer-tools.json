{
  "schema_version": "1.0",
  "description": "Peer audit tools by language and role, distilled from the Web3 Security Tools Hub (github.com/pashov/ai-web3-security). Invariant Helix cites these when a capability is unavailable or when an independent second opinion strengthens verifier independence. IH does not bundle, execute, or endorse them; each stays under its own license and its output enters IH as a hypothesis, never a finding.",
  "source": "https://github.com/pashov/ai-web3-security",
  "roles": {
    "auditor": "generates vulnerability hypotheses from source",
    "static-analyzer": "deterministic pattern/dataflow analysis",
    "fuzzer": "property or coverage-guided input generation",
    "scoping": "pre-audit modelling and threat surface enumeration",
    "judge": "scores, dedups, or triages findings",
    "known-findings": "checks a candidate against already-disclosed issues",
    "guardrails": "secure-development assistance while writing code"
  },
