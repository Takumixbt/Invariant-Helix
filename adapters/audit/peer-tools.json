{
  "schema_version": "1.1",
  "description": "Optional peer tools IH may cite when a capability is missing. Not bundled. Output enters as hypotheses only.",
  "roles": {
    "auditor": "generates vulnerability hypotheses from source",
    "static-analyzer": "deterministic pattern/dataflow analysis",
    "fuzzer": "property or coverage-guided input generation",
    "scoping": "pre-audit modelling",
    "judge": "scores or triages findings",
    "known-findings": "dedup against disclosed issues",
    "guardrails": "secure-development assistance"
  },
  "tools": [
    {"name": "slither", "url": "https://github.com/crytic/slither", "languages": ["solidity"], "roles": ["static-analyzer"]},
    {"name": "echidna", "url": "https://github.com/crytic/echidna", "languages": ["solidity"], "roles": ["fuzzer"]},
    {"name": "medusa", "url": "https://github.com/crytic/medusa", "languages": ["solidity"], "roles": ["fuzzer"]},
    {"name": "foundry", "url": "https://github.com/foundry-rs/foundry", "languages": ["solidity"], "roles": ["fuzzer", "static-analyzer"]},
    {"name": "Aderyn", "url": "https://github.com/Cyfrin/aderyn", "languages": ["solidity"], "roles": ["static-analyzer"]},
    {"name": "0xsimao findings corpus", "url": "https://0xsimao.com", "languages": ["solidity"], "roles": ["known-findings"], "note": "ingest locally via ih-findings-ingest"},
    {"name": "DeFi incident DB", "url": "https://github.com/kismp123/DeFi-Security-Incident", "languages": ["solidity"], "roles": ["known-findings"]},
    {"name": "trickest/cve", "url": "https://github.com/trickest/cve", "languages": ["multi"], "roles": ["known-findings"]},
    {"name": "Burp Suite", "url": "https://portswigger.net/burp", "languages": ["multi"], "roles": ["auditor"]},
    {"name": "digger", "url": "https://github.com/digger-determsec/digger", "languages": ["multi"], "roles": ["auditor", "static-analyzer"]}
  ],
  "independence_rule": "A peer tool may generate hypotheses. It may NOT verify its own finding. Status only moves via IH G7/G8."
}
