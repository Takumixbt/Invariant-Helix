{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invariant-helix.dev/schemas/chain-adapter.schema.json",
  "title": "Invariant Helix chain adapter registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapters"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adapter_id", "chain_family", "status", "maturity_tier", "document",
          "detection_markers", "enumeration_strategy", "authority_model", "state_model",
          "trace_strategy", "simulation_strategy", "property_strategy",
          "reproduction_format", "known_gaps"
        ],
        "properties": {
          "adapter_id": {"type": "string", "minLength": 1},
          "chain_family": {"type": "string", "minLength": 1},
          "status": {"enum": ["methodology-only", "executable"]},
          "maturity_tier": {"type": "integer", "minimum": 1, "maximum": 3},
          "document": {"type": "string", "minLength": 1},
          "detection_markers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "enumeration_strategy": {"type": "string", "minLength": 1},
          "authority_model": {"type": "string", "minLength": 1},
          "state_model": {"type": "string", "minLength": 1},
          "trace_strategy": {"type": "string", "minLength": 1},
          "simulation_strategy": {"type": "string", "minLength": 1},
          "property_strategy": {"type": "string", "minLength": 1},
          "reproduction_format": {"type": "string", "minLength": 1},
          "known_gaps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
