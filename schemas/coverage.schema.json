{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invariant-helix.dev/schemas/coverage.schema.json",
  "title": "Invariant Helix coverage bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "snapshot_id", "termination_status", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "termination_status": {"enum": ["complete", "complete_with_limitations", "inconclusive", "blocked", "aborted"]},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "coverage_id", "case_id", "snapshot_id", "target_refs", "impact_class", "owner",
          "hypothesis_families", "planned_observations", "negative_controls", "verifier_id",
          "status", "evidence_refs", "dependencies"
        ],
        "properties": {
          "coverage_id": {"type": "string", "minLength": 1},
          "case_id": {"type": "string", "minLength": 1},
          "snapshot_id": {"type": "string", "minLength": 1},
          "target_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "impact_class": {"enum": ["critical", "high", "medium", "low", "informational"]},
          "owner": {"type": "string", "minLength": 1},
          "hypothesis_families": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "planned_observations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "negative_controls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "verifier_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "in_progress", "tested", "verified", "refuted", "blocked", "excluded", "uncovered", "stale"]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "blocker": {"type": "string", "minLength": 1},
          "exclusion_reason": {"type": "string", "minLength": 1},
          "lens": {"type": "string", "minLength": 1, "description": "attacker lens this coverage item belongs to"},
          "capability": {"type": "string", "minLength": 1, "description": "capability required to exercise this item"}
        }
      }
    }
  }
}
